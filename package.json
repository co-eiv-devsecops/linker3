{
  "name": "linker",
  "version": "1.0.0",
  "description": "Acortador de URLs monolítico",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "node --experimental-strip-types --env-file-if-exists=.env src/main.ts",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "test:coverage:check": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^26.1.1",
    "husky": "9.1.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@launchdarkly/node-server-sdk": "^9.12.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "mysql2": "^3.22.6"
  }
}
