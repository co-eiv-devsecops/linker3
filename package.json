{
  "name": "linker",
  "version": "1.0.0",
  "description": "Acortador de URLs monolítico",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage \"test/**/*.test.ts\"",
    "test:coverage:check": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "^24.0.0",
    "husky": "9.1.7",
    "typescript": "^5.8.0"
  }
}
