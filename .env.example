# --- HTTP server ---
PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=linker.db

# --- Feature flags ---
# Selects the code generator: true = SecureCodeGenerator, false = RandomCodeGenerator
FEATURE_NEW_CODE_GEN=false

# --- Logging ---
# Minimum log level emitted (debug|info|warn|error). Lower levels are silenced without recompiling.
LOG_LEVEL=info

# --- MySQL (used by GET /healthz, runs "SELECT 1") ---
MYSQL_HOST=10.0.65.126
MYSQL_DATABASE=linker_db_X
MYSQL_USER=linker_user_X
# NEVER commit the real value; get it from Oracle Cloud Vault Secrets.
MYSQL_PWD=

# --- LaunchDarkly ---
# Server-side SDK key (starts with "sdk-"). Get it from LaunchDarkly:
# Account settings → Projects → <env> → SDK key. NEVER commit the real value.
# If unset, the app starts LaunchDarkly in offline mode (flags fall back to defaults).
LAUNCHDARKLY_SDK_KEY=sdk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- OpenTelemetry (observability) ---
# OTLP collector/backend endpoint. Traces, metrics and logs are sent here.
# Same deployable artifact: point it at Grafana Cloud (or any OTLP receiver)
# by changing only this variable — no rebuild required.
# Default when unset: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Wire protocol used by the OTLP exporters (http/protobuf | http/json).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Optional headers (e.g. auth). Format: key1=value1,key2=value2
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <token>
# Logical service name reported in every trace/metric/log.
OTEL_SERVICE_NAME=linker-3
