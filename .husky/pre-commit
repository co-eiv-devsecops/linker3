branch_name=$(git symbolic-ref --short HEAD)

if [ "$branch_name" = "main" ]; then
    echo "You cannot commit directly to the main branch."
    exit 1
fi

if [ "$branch_name" = "develop" ]; then
    echo "You cannot commit directly to the develop branch."
    exit 1
fi

files=$(git diff --name-only --cached --diff-filter=ACMR -- '*.ts' '*.json')

if [ -n "$files" ]; then
  echo "$files" | xargs npx biome check --write --no-errors-on-unmatched
  echo "$files" | xargs git add
fi

npm run typecheck
npm test
